PORT=3001
HOST=127.0.0.1
DATABASE_PATH=data/insurance.sqlite
APP_ORIGIN=http://localhost:5173
# Local demonstrations: no PayHere account, network call, card or real payment.
PAYMENT_MODE=demo
# After deployment, switch to payhere-sandbox and configure the values below.
# NODE_ENV=production rejects demo mode. Live payments are never supported.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_NOTIFY_URL=
# Optional first-start administrator password override:
# ADMIN_PASSWORD=
